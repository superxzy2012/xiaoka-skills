FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc novnc websockify socat ca-certificates procps curl \
    libgtk-3-0 libnss3 libasound2 libgbm1 libxss1 libxtst6 libxrandr2 \
    libatk-bridge2.0-0 libatk1.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libpango-1.0-0 libcairo2 libx11-xcb1 \
    fonts-noto-cjk fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# AppImage 先放构建上下文，解包后删掉，避免镜像里留 107MB
COPY app.AppImage /app/app.AppImage
RUN chmod +x app.AppImage && ./app.AppImage --appimage-extract >/dev/null \
 && mv squashfs-root electron && rm -f app.AppImage
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh
EXPOSE 8080 6080 9223
CMD ["/app/start.sh"]
